msgctxt "Addon Summary"
msgid "Nintendo - Game Boy Advance (gpSP)"
msgstr "任天堂 - Game Boy Advance (gpSP)"

msgctxt "Addon Description"
msgid "gpSP is a Game Boy Advance emulator based on notaz's fork of gpSP with additional codebase improvements."
msgstr "gpSP 是一款基于 notaz 的 gpSP 分支的 Game Boy Advance 模拟器，具有额外的代码库改进。"

msgctxt "#30001"
msgid "BIOS"
msgstr "BIOS"

msgctxt "#30002"
msgid "Boot mode"
msgstr "引导模式"

